-- ─────────────────────────────────────────────────────────────────────────────
--  Config (save / load / list)
-- ─────────────────────────────────────────────────────────────────────────────
local config = {}

function config.save(name)
	if not writefile then return end
	local data = {}
	for k, v in pairs(flags) do
		if type(v) == "boolean" or type(v) == "number" or type(v) == "string" then
			data[k] = v
		elseif type(v) == "table" then
			data[k] = v
		elseif typeof(v) == "Color3" then
			data[k] = { r = v.R, g = v.G, b = v.B }
		end
	end
	pcall(function()
		if not isfolder("juju") then makefolder("juju") end
		if not isfolder("juju/configs") then makefolder("juju/configs") end
		writefile("juju/configs/" .. name .. ".json", hs:JSONEncode(data))
	end)
end

function config.load(name, no_load_flags)
	if not readfile then return end
	pcall(function()
		local raw = readfile("juju/configs/" .. name .. ".json")
		local data = hs:JSONDecode(raw)
		for k, v in pairs(data) do
			if no_load_flags and utility.find(no_load_flags, k) then continue end
			if type(v) == "table" and v.r and v.g and v.b then
				flags[k] = colorfromrgb(v.r * 255, v.g * 255, v.b * 255)
			else
				flags[k] = v
			end
		end
		menu.on_load:Fire()
	end)
end

function config.list()
	if not listfiles then return {} end
	local result = {}
	pcall(function()
		for _, path in listfiles("juju/configs") do
			local name = path:match("([^/\\]+)%.json$")
			if name then utility.insert(result, name) end
		end
	end)
	return result
end

