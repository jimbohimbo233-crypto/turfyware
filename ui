--  Utility
-- ─────────────────────────────────────────────────────────────────────────────
local utility = { connections = {}, is_dragging_blocked = false }

do
	local newInstance = Instance.new
	local keybindBlacklist = { Enum.KeyCode.Escape, Enum.KeyCode.Tilde }

	utility.newConnection = function(signal, callback, cache)
		local c = signal:Connect(callback)
		if cache then utility.connections[#utility.connections + 1] = c end
		return c
	end

	utility.copyTable = function(original)
		local copy = {}
		for k, v in pairs(original) do
			copy[k] = type(v) == "table" and utility.copyTable(v) or v
		end
		return copy
	end

	utility.removeBrackets = function(s)
		return lower(s):gsub('[%p%c%s]', '')
	end

	utility.round = function(num, decimals)
		local mult = 10 ^ (decimals or 0)
		return floor(num * mult + 0.5) / mult
	end

	utility.find = function(array, find)
		for k, v in pairs(array) do
			if find == v then return k end
		end
	end

	utility.insert = function(array, v)
		array[#array + 1] = v
	end

	utility.isValidKey = function(keycode)
		return not utility.find(keybindBlacklist, keycode)
	end

	utility.length = function(array)
		local n = 0
		for _ in pairs(array) do n += 1 end
		return n
	end

	utility.remove = function(array, v, z)
		array[z or utility.find(array, v)] = nil
	end

	utility.newDrawing = function(class, props)
		local obj = Drawing.new(class)
		for p, val in props do setrenderproperty(obj, p, val) end
		return obj
	end

	utility.tween = function(...)
		tws:Create(...):Play()
	end

	utility.setDraggable = function(object)
		local dragging = false
		utility.newConnection(object.InputBegan, function(input, gpe)
			if gpe then return end
			if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not utility.is_dragging_blocked then
				local ml = uis:GetMouseLocation()
				local sx, sy = ml.X, ml.Y
				local ox, oy = object.Position.X.Offset, object.Position.Y.Offset
				dragging = true
				_spawn(function()
					while dragging and not utility.is_dragging_blocked do
						ml = uis:GetMouseLocation()
						object.Position = udim2new(0, ox - (sx - ml.X), 0, oy - (sy - ml.Y))
						_wait()
					end
				end)
			end
		end)
		utility.newConnection(object.InputEnded, function(input, gpe)
			if gpe then return end
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
	end

	utility.isInFrame = function(object, pos)
		local ap = object.AbsolutePosition
		local as = object.AbsoluteSize
		return ap.Y <= pos.Y and pos.Y <= ap.Y + as.Y and ap.X <= pos.X and pos.X <= ap.X + as.X
	end

	utility.isInUI = function(gui1, gui2)
		local tl1, br1 = gui1.AbsolutePosition, gui1.AbsolutePosition + gui1.AbsoluteSize
		local tl2, br2 = gui2.AbsolutePosition, gui2.AbsolutePosition + gui2.AbsoluteSize
		return tl1.X < br2.X and br1.X > tl2.X and tl1.Y < br2.Y and br1.Y > tl2.Y
	end

	utility.newObject = function(class, props)
		local obj = newInstance(class)
		for p, v in props do obj[p] = v end
		obj.Name = props["Name"] or ""
		return obj
	end
end

-- ─────────────────────────────────────────────────────────────────────────────
--  Signal
-- ─────────────────────────────────────────────────────────────────────────────
local signal = {}
signal.__index = signal

function signal.new()
	return setmetatable({ connections = {} }, signal)
end

function signal:Fire(...)
	for _, cb in pairs(self.connections) do _spawn(cb, ...) end
end

function signal:Connect(cb)
	local conns = self.connections
	utility.insert(conns, cb)
	local conn = {}
	function conn:Disconnect()
		utility.remove(conns, cb)
		conn = nil
	end
	return conn
end

