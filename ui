		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not menu.busy then
			isDraggingResize = true
			utility.is_dragging_blocked = true
			local oldSize = Border.Size
			_spawn(function()
				while isDraggingResize do
					local change = uis:GetMouseLocation() - (Border.AbsolutePosition + Border.AbsoluteSize + vector2new(0, 36))
					Border.Size = udim2new(0, clamp(oldSize.X.Offset + change.X, 658, 5000), 0, clamp(oldSize.Y.Offset + change.Y, 558, 5000))
					oldSize = Border.Size
					BottomGap.Size     = udim2new(0, 73, 0, 22 + Border.Size.Y.Offset - 558)
					BottomGap.Position = udim2new(0, 0, 1, -BottomGap.Size.Y.Offset)
					_wait()
				end
			end)
		end
	end)
	utility.newConnection(Dragger.InputEnded, function(input, gpe)
		if gpe then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if isDraggingResize then isDraggingResize = false; utility.is_dragging_blocked = false end
		end
	end)

	utility.setDraggable(Border)

	local new_window = {
		tab_holder = TabHolder,
		active_tab = nil,
		background = Background,
		tabs       = {}
	}
	setmetatable(new_window, window)

	local is_first_tab = true
	for int = 1, 8 do
		if tabs[int] then
			new_window:_registerTab(int, tabs[int], is_first_tab)
			is_first_tab = false
		end
	end

	function new_window:getTab(int) return self.tabs[int] end

	-- close / open animations
	local tweenFrames = { Border, Border2, TopGap, BottomGap, BottomSideFix, TopSideFix, BlackBar }
	local function setMenuVisible(visible)
		local t  = visible and 0 or 1
		local ti = newtweeninfo(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		for _, f in tweenFrames do utility.tween(f, ti, { BackgroundTransparency = t }) end
		utility.tween(Background, ti, { ImageTransparency = t })
		utility.tween(TopBar_2,   ti, { ImageTransparency = t })
		if visible then
			_screenGui.Enabled = true
			menu.is_open = true
		else
			task.delay(0.25, function()
				_screenGui.Enabled = false
				menu.is_open = false
			end)
		end
	end

	utility.newConnection(menu.on_closing, function() setMenuVisible(false) end, true)
	utility.newConnection(menu.on_opening, function() setMenuVisible(true)  end, true)

	return new_window
end

